# Optional localhost-only PostgreSQL tooling. Supabase is the supported default.
STOCKFLOW_DB_NAME="stockflow_dev"
STOCKFLOW_DB_USER="stockflow_dev"
STOCKFLOW_DB_PASSWORD="replace_with_local_only_password"
STOCKFLOW_DB_PORT="54329"

DATABASE_URL="postgresql://stockflow_dev:replace_with_local_only_password@127.0.0.1:54329/stockflow_dev?schema=public"
DIRECT_URL="postgresql://stockflow_dev:replace_with_local_only_password@127.0.0.1:54329/stockflow_dev?schema=public"
STOCKFLOW_DATABASE_TARGET="development-disposable"
