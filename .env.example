# Server-only runtime connection. Copy the transaction-pooler URL from the
# Supabase Connect panel for the intended environment (development or production).
DATABASE_URL="postgresql://prisma.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&uselibpqcompat=true&sslmode=require"

# Server/admin-only migration connection. Copy the direct or session-pooler URL
# from Supabase. Prisma CLI reads this variable through prisma.config.ts.
DIRECT_URL="postgresql://prisma.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

# Required safety acknowledgement before the integration suite writes temporary
# fixtures. Set only for an explicitly verified disposable development project.
STOCKFLOW_DATABASE_TARGET="development-disposable"

# Reserved for the secure Phase 1B authentication implementation.
# Generate a high-entropy value; never reuse the example text.
AUTH_SECRET="replace_with_a_high_entropy_secret"
