{
  "name": "stockflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "admin:bootstrap": "tsx scripts/bootstrap-first-admin.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:connectivity": "tsx scripts/check-database-connections.ts",
    "db:inspect": "tsx scripts/inspect-database-readiness.ts",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:local:up": "docker compose --env-file .env.docker up -d --wait postgres",
    "db:local:down": "docker compose --env-file .env.docker down",
    "db:local:logs": "docker compose --env-file .env.docker logs postgres",
    "db:local:recreate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/recreate-development-database.ps1",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run prisma:validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "1.7.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.4",
    "next": "^16.3.7",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
